%%%%%%%%%%%%
% COMMANDS %
%%%%%%%%%%%%

% Undefined image
\newcommand{\mnfundef}{%
    \filldraw[draw=red,fill=red!50] (0,0) rectangle (1,1);
    \node at (0.5,0.5) {{\color{red}\bf\LARGE ?}};
}

% 1 -> 2 diagram
\newcommand{\mnfonetotwo}[3]{%
    \draw[#1] (0,0) -- (0.5,0);
    \draw[#2] (0.5,0) -- (1,0.5);
    \draw[#3] (0.5,0) -- (1,-0.5);
}

% 2 -> 2 diagram
\newcommand{\mnftwototwo}[6][T]{%
    \switch%
        \case{\pdfstrcmp{#1}{T}}{%
            \draw[#2] (0,1) -- (0.5,0.75);
            \draw[#3] (0,0) -- (0.5,0.25);
            \draw[#4] (0.5,0.75) -- (0.5,0.25);
            \draw[#5] (0.5,0.75) -- (1,1);
            \draw[#6] (0.5,0.25) -- (1,0);
        }
        \case{\pdfstrcmp{#1}{S}}{%
            \draw[#2] (0,1) -- (0.25,0.5);
            \draw[#3] (0,0) -- (0.25,0.5);
            \draw[#4] (0.25,0.5) -- (0.75,0.5);
            \draw[#5] (0.75,0.5) -- (1,1);
            \draw[#6] (0.75,0.5) -- (1,0);
        }
        \case{\pdfstrcmp{#1}{X}}{%
            \draw[#2] (0,1) -- (0.5,0.5);
            \draw[#3] (0,0) -- (0.5,0.5);
            \draw[#5] (0.5,0.5) -- (1,1);
            \draw[#6] (0.5,0.5) -- (1,0);
        }
        \otherwise%
            \mnfundef
    \endswitch%
}

% One-loop diagram
\newcommand{\mnfoneloop}[3][B]{%
    \switch%
        \case{\pdfstrcmp{#1}{B}}{%
            \draw[#2] (0.0,0.0) -- (0.5,0.0);
            \draw[#3] (1,0) circle(0.5);
            \draw[#2] (1.5,0.0) -- (2.0,0.0);
        }
        \case{\pdfstrcmp{#1}{T}}{%
            \draw[#2] (0.0,0.0) -- (2.0,0.0);
            \draw[#3] (1,0.5) circle(0.5);
        }
        \otherwise%
            \mnfundef%
    \endswitch%
}
