%%%%%%%%%%
% STYLES %
%%%%%%%%%%

\tikzset{%
    mnf-fer/.style={},
    mnf-dfer/.style={double,line width=0.75pt},
    mnf-sca/.style={dashed},
    mnf-chasca/.style={dashed,decoration={markings,mark=at position 0.7 with {\arrow{Triangle[angle=60:2 2]}}},postaction=decorate},
